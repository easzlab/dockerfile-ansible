FROM python:3.12.15-alpine3.24

ENV ANSIBLE_VER=14.5.0
ENV EASZLAB_ANSIBLE_TAG=14.5.0-lite

RUN apk --no-cache add \
        bash \
        openssh-client \
        rsync

RUN pip install --no-cache-dir --only-binary=:all: \
        ansible=="$ANSIBLE_VER" \
        ansible-core==2.21.5 \
       # Keep common, maintained collections and their declared dependencies
    && cd /usr/local/lib/python3.12/site-packages/ansible_collections \
    && find . -mindepth 2 -maxdepth 2 -type d \
        ! -path './ansible/*' \
        ! -path './community/crypto' \
        ! -path './community/dns' \
        ! -path './community/docker' \
        ! -path './community/general' \
        ! -path './community/hashi_vault' \
        ! -path './community/library_inventory_filtering_v1' \
        ! -path './community/mysql' \
        ! -path './community/postgresql' \
        -exec rm -rf {} + \
    && find . -mindepth 1 -maxdepth 1 -type d -empty -delete \
       # Some module need '/usr/bin/python' exist
    && ln -s -f /usr/local/bin/python3 /usr/bin/python \
    && ln -s -f /usr/local/bin/python3 /usr/bin/python3 \
       # Cleaning
    && rm -rf /root/.cache

CMD [ "sleep", "360000000" ]
